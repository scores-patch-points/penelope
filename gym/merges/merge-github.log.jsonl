{"schema":"ProgramLog@1","seq":0,"kind":"file","path":"gym/merges/tip-temp-merged.html","code":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><title>Merged: tip calculator + temperature converter</title>\n<style>body{font:16px/1.5 system-ui;max-width:44rem;margin:2rem auto;padding:0 1rem}section{border:1px solid #ccc;border-radius:10px;padding:1rem 1.25rem;margin:1rem 0}output{display:block;margin-top:.5rem;font-weight:600}</style></head>\n<body>\n<h1>Two real code bases, merged into one</h1>\n<p style=\"color:#555\">BASE A: github:mmilowicki/Lab-3---Tip-Calculator · BASE B: github:mothy-08/temperature-converter — both fetched verbatim (sha-pinned), merged into one page, held by the same judge.</p>\n<section data-widget=\"tip-calculator\"><h2>Tip calculator <small>(BASE A)</small></h2><form id=\"tip-form\">\n            <div class=\"form-group\">\n                <label for=\"billTotal\">Bill Total:</label>\n                <input type=\"number\" id=\"billTotal\" placeholder=\"Enter Bill Total\" class=\"input-field\">\n                <div id=\"billTotalError\" class=\"error-message\"></div>\n            </div>\n            <div class=\"form-group\">\n                <label for=\"tipSlider\">Tip:</label>\n                <input type=\"range\" id=\"tipSlider\" min=\"0\" max=\"100\" value=\"15\" class=\"slider\">\n            </div>\n            <div class=\"form-group\">\n                <label for=\"tipPercentage\">Tip Percentage:</label>\n                <input type=\"text\" id=\"tipPercentage\" readonly class=\"output\">\n            </div>\n            <div class=\"form-group\">\n                <label for=\"tipAmount\">Tip Amount:</label>\n                <input type=\"text\" id=\"tipAmount\" readonly class=\"output\">\n            </div>\n            <div class=\"form-group\">\n                <label for=\"totalBill\">Total Bill with Tip:</label>\n                <input type=\"text\" id=\"totalBill\" readonly class=\"output\">\n            </div>\n        </form></section>\n<section data-widget=\"temperature-converter\"><h2>Temperature converter <small>(BASE B)</small></h2><form\n        id=\"temperature-form\"\n        class=\"outfit-400\"\n        aria-labelledby=\"form-title\"\n      >\n        <h1 id=\"form-title\">Temperature Converter</h1>\n\n        <label for=\"temperature-input\">\n          Enter the temperature, select units, then submit\n        </label>\n\n        <div class=\"conversion-wrapper\">\n          <input\n            type=\"text\"\n            name=\"temperature-input\"\n            id=\"temperature-input\"\n            placeholder=\"0.00\"\n            autofocus\n            autocomplete=\"off\"\n            required\n            aria-required=\"true\"\n          />\n          <label for=\"temperature-units-select-from\" class=\"visually-hidden\">\n            Choose a unit to convert from:\n          </label>\n          <select\n            name=\"temperature-units-from\"\n            id=\"temperature-units-select-from\"\n            required\n            aria-required=\"true\"\n          >\n            <option value=\"\" disabled selected>From Unit</option>\n            <option value=\"fahrenheit\">Fahrenheit</option>\n            <option value=\"celsius\">Celsius</option>\n            <option value=\"kelvin\">Kelvin</option>\n          </select>\n\n          <span>to</span>\n\n          <label for=\"temperature-units-select-to\" class=\"visually-hidden\">\n            Choose a unit to convert to:\n          </label>\n          <select\n            name=\"temperature-units-to\"\n            id=\"temperature-units-select-to\"\n            required\n            aria-required=\"true\"\n          >\n            <option value=\"\" disabled selected>To Unit</option>\n            <option value=\"fahrenheit\">Fahrenheit</option>\n            <option value=\"celsius\">Celsius</option>\n            <option value=\"kelvin\">Kelvin</option>\n          </select>\n          <button class=\"convert-button\" id=\"convert-button\" disabled>\n            Convert\n          </button>\n        </div>\n\n        <p\n          class=\"display-conversion\"\n          id=\"display-conversion\"\n          aria-live=\"polite\"\n        ></p>\n      </form></section>\n<script id=\"merged-sources\" type=\"application/json\">[\n  {\n    \"role\": \"base-a-script\",\n    \"origin\": \"github:mmilowicki/Lab-3---Tip-Calculator@main\",\n    \"sha\": \"c465773bc9a2\",\n    \"bytes\": 1015\n  },\n  {\n    \"role\": \"base-b-script\",\n    \"origin\": \"github:mothy-08/temperature-converter@main\",\n    \"sha\": \"89b0032c8cda\",\n    \"bytes\": 3720\n  },\n  {\n    \"role\": \"base-b-kernel:celsiusToFahrenheit\",\n    \"origin\": \"github:mothy-08/temperature-converter@main\",\n    \"address\": \"github:mothy-08/temperature-converter@main main.js#3455\",\n    \"sha\": \"8f5808223084\"\n  },\n  {\n    \"role\": \"base-b-kernel:celsiusToKelvin\",\n    \"origin\": \"github:mothy-08/temperature-converter@main\",\n    \"address\": \"github:mothy-08/temperature-converter@main main.js#3227\",\n    \"sha\": \"61af2546b928\"\n  },\n  {\n    \"role\": \"base-b-const:ABSOLUTE_ZERO\",\n    \"origin\": \"github:mothy-08/temperature-converter@main\",\n    \"address\": 13,\n    \"sha\": \"52541d6895d0\"\n  },\n  {\n    \"role\": \"derived-tip-contract (from base-a line)\",\n    \"source\": \"var tipAmount = billTotal * (tipPercent / 100);\"\n  }\n]</script>\n<script>\n// THE MERGED KERNEL — real bytes from BASE B (const + two functions), and the\n// contract derived from BASE A's real line (var tipAmount = billTotal * (tipPercent / 100);…) exposed by the box.\nconst ABSOLUTE_ZERO = 273.15;\nfunction celsiusToFahrenheit(celsius) {\n  return celsius * (9 / 5) + 32;\n}\nfunction celsiusToKelvin(celsius) {\n  return celsius + ABSOLUTE_ZERO;\n}\nfunction tipComponents(bill, pct) { var tip = Math.round(bill * pct) / 100; return { tip: tip, total: Math.round((bill + tip) * 100) / 100 }; }\n</script>\n<script>\n// THE REAL SCRIPTS, VERBATIM, run only where a document exists (the judge has\n// none — it reads the kernel block above; a real page runs both bases).\nif (typeof document !== \"undefined\") {\ndocument.addEventListener('DOMContentLoaded', function() {\n    var billTotalInput = document.getElementById('billTotal');\n    var tipSlider = document.getElementById('tipSlider');\n    var tipPercentageDisplay = document.getElementById('tipPercentage');\n    var tipAmountDisplay = document.getElementById('tipAmount');\n    var totalBillDisplay = document.getElementById('totalBill');\n    var tipForm = document.getElementById('tip-form'); \n\n    function calculateTip() {\n        var billTotal = parseFloat(billTotalInput.value);\n        if (isNaN(billTotal)) {\n            billTotal = 0;\n        }\n        var tipPercent = parseInt(tipSlider.value, 10);\n        tipPercentageDisplay.value = tipPercent + '%';\n        \n        var tipAmount = billTotal * (tipPercent / 100);\n        tipAmountDisplay.value = '$' + tipAmount.toFixed(2);\n        \n        var totalBill = billTotal + tipAmount;\n        totalBillDisplay.value = '$' + totalBill.toFixed(2);\n    }\n\n    tipForm.addEventListener('input', calculateTip);\n});\n\n// Constants\nconst ABSOLUTE_ZERO = 273.15;\nconst allowedKeys = [\n  \"Backspace\",\n  \"Tab\",\n  \"Escape\",\n  \"ArrowUp\",\n  \"ArrowRight\",\n  \"ArrowDown\",\n  \"ArrowLeft\",\n  \"Enter\",\n  \"-\",\n];\n\n// DOM Elements\nconst temperatureInput = document.getElementById(\"temperature-input\");\nconst units = document.querySelectorAll(\"select\");\nconst temperatureForm = document.getElementById(\"temperature-form\");\nconst convertButton = document.getElementById(\"convert-button\");\nconst unitFrom = document.getElementById(\"temperature-units-select-from\");\nconst unitTo = document.getElementById(\"temperature-units-select-to\");\nconst displayConversion = document.getElementById(\"display-conversion\");\n\n// Event Listeners\ntemperatureInput.addEventListener(\"keydown\", handleKeyDown);\ntemperatureInput.addEventListener(\"input\", checkFields);\nunits.forEach((unit) => {\n  unit.addEventListener(\"change\", () => {\n    disableOptions(unit);\n    checkFields();\n  });\n});\ntemperatureForm.addEventListener(\"submit\", handleFormSubmit);\n\n// Initialize\nunits.forEach(disableOptions);\ncheckFields();\n\n// Functions\nfunction handleKeyDown(event) {\n  const inputValue = event.target.value;\n  const isMinusSign = event.key === \"-\";\n  const isNotFirstCharacter = event.target.selectionStart !== 0;\n  const isInvalidNumber =\n    isNaN(Number(event.key)) && !allowedKeys.includes(event.key);\n\n  if (\n    (isMinusSign && (inputValue.includes(\"-\") || isNotFirstCharacter)) ||\n    isInvalidNumber\n  ) {\n    event.preventDefault();\n  }\n}\n\nfunction disableOptions(selectedUnit) {\n  const selectedValue = selectedUnit.value;\n  units.forEach((unit) => {\n    if (unit !== selectedUnit) {\n      Array.from(unit.options).forEach((option, index) => {\n        if (index !== 0) option.disabled = option.value === selectedValue;\n      });\n    }\n  });\n}\n\nfunction checkFields() {\n  const allFilled =\n    temperatureInput.value.trim() !== \"\" &&\n    [...units].every((unit) => unit.value !== \"\");\n  convertButton.disabled = !allFilled;\n}\n\nfunction handleFormSubmit(event) {\n  event.preventDefault();\n\n  const formData = {\n    temperature: Number(temperatureInput.value),\n    unitFrom: unitFrom.value,\n    unitTo: unitTo.value,\n  };\n\n  let result = convert(\n    formData.temperature,\n    formData.unitFrom,\n    formData.unitTo\n  );\n  result = Number.isInteger(result) ? result : result.toFixed(2);\n\n  displayConversion.textContent = `${formData.temperature} ${formData.unitFrom} is ${result} ${formData.unitTo}`;\n  temperatureInput.value = \"\";\n  checkFields();\n}\n\nfunction convert(temperatureValue, unitFrom, unitTo) {\n  if (unitFrom === \"celsius\" && unitTo === \"kelvin\") {\n    return celsiusToKelvin(temperatureValue);\n  } else if (unitFrom === \"kelvin\" && unitTo === \"celsius\") {\n    return kelvinToCelsius(temperatureValue);\n  } else if (unitFrom === \"fahrenheit\" && unitTo === \"celsius\") {\n    return fahrenheitToCelsius(temperatureValue);\n  } else if (unitFrom === \"celsius\" && unitTo === \"fahrenheit\") {\n    return celsiusToFahrenheit(temperatureValue);\n  } else if (unitFrom === \"fahrenheit\" && unitTo === \"kelvin\") {\n    return fahrenheitToKelvin(temperatureValue);\n  } else if (unitFrom === \"kelvin\" && unitTo === \"fahrenheit\") {\n    return kelvinToFahrenheit(temperatureValue);\n  }\n}\n\nfunction celsiusToKelvin(celsius) {\n  return celsius + ABSOLUTE_ZERO;\n}\n\nfunction kelvinToCelsius(kelvin) {\n  return kelvin - ABSOLUTE_ZERO;\n}\n\nfunction fahrenheitToCelsius(fahrenheit) {\n  return (fahrenheit - 32) * (5 / 9);\n}\n\nfunction celsiusToFahrenheit(celsius) {\n  return celsius * (9 / 5) + 32;\n}\n\nfunction fahrenheitToKelvin(fahrenheit) {\n  return (fahrenheit - 32) * (5 / 9) + ABSOLUTE_ZERO;\n}\n\nfunction kelvinToFahrenheit(kelvin) {\n  return (kelvin - ABSOLUTE_ZERO) * (9 / 5) + 32;\n}\n\n}\n</script>\n</body></html>","source":"fetched-verbatim","address":"github:mmilowicki/Lab-3---Tip-Calculator@main + github:mothy-08/temperature-converter@main"}
{"schema":"ProgramLog@1","seq":1,"kind":"file","path":"gym/merges/check-merged.test.mjs","code":"// gym/merges/check-merged.test.mjs — MERGED by widget-merge-github-demo.mjs.\n// Reads the merged artifact (two real GitHub widgets in one page) back from\n// disk and holds it: tip contract (derived from BASE A's real line) and the\n// two real kernels merged from BASE B (celsiusToFahrenheit, celsiusToKelvin).\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { judgePage } from \"../../organs/behavior-check.mjs\";\nconst HERE = path.dirname(fileURLToPath(import.meta.url));\ntest(\"the merged page holds: derived tip contract + BASE B's real kernels\", () => {\n  const html = fs.readFileSync(path.join(HERE, \"tip-temp-merged.html\"), \"utf8\");\n  const r = judgePage(html, {\n    needs: [\"tipComponents\", \"celsiusToFahrenheit\", \"celsiusToKelvin\"],\n    cases: [\n      { fn: \"tipComponents\", args: [100, 20], compute: { kind: \"tip\", amount: 100, percent: 20 } },\n      { fn: \"celsiusToFahrenheit\", args: [100], compute: { expression: \"c*9/5+32\", bind: { c: 100 } } },\n      { fn: \"celsiusToKelvin\", args: [0], compute: { expression: \"c+273.15\", bind: { c: 0 } } },\n    ],\n  });\n  assert.equal(r.ok, true, r.findings.map((f) => f.detail).join(\"; \"));\n  assert.ok(r.observations.every((o) => o.cell && o.cell.op), \"every act carries a cube cell\");\n});\n","source":"generated-test","address":"box:test-template"}
